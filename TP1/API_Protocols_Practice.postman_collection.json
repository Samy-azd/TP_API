{
  "info": {
    "name": "API Protocols Practice",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET Posts",
      "request": {
        "method": "GET",
        "header": [
          { "key": "User-Agent", "value": "PostmanRuntime-TP1" },
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/posts",
          "host": ["{{base_url}}"],
          "path": ["posts"]
        }
      }
    },
    {
      "name": "POST Create Post",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Nouveau post\",\n  \"body\": \"Ceci est le corps du nouveau post.\",\n  \"userId\": 1\n}",
          "options": {
            "raw": { "language": "json" }
          }
        },
        "url": {
          "raw": "{{base_url}}/posts",
          "host": ["{{base_url}}"],
          "path": ["posts"]
        }
      }
    }
  ]
}
